# Kopieer naar studio/.env (gitignored; de repo is openbaar).
# Sanity zet SANITY_STUDIO_*-variabelen tijdens `npm run deploy` in de Studio.

# Umami-deellink voor het tabblad Bezoekersstatistiek (Umami Cloud ->
# Websites -> desingel -> Share URL). Leeg = het tabblad verdwijnt bij de
# volgende Studio-deploy.
SANITY_STUDIO_UMAMI_SHARE_URL=https://cloud.umami.is/share/xxxxxxxx
