# Kopieer naar .env en vul de echte waarden in (nooit committen).
# De echte waarden staan in de oude .env, in sanity.io/manage of bij Web3Forms.

# --- Nodig voor dev en build ---
SANITY_PROJECT_ID=vua8q73o
SANITY_DATASET=production

# Contactformulier (web3forms.com). In CI komt deze uit de repo-variabele
# WEB3FORMS_ACCESS_KEY; lokaal alleen nodig om het formulier te testen.
NUXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# --- Beheersleutels (optioneel, zie NOG-TE-DOEN.md) ---
# Editor-token (sanity.io/manage -> API -> Tokens); alleen nodig voor de
# seed-/migratiescripts in scripts/eenmalig/.
SANITY_TOKEN=your-sanity-editor-token

# Fine-grained PAT (alleen repo desingel, Contents R/W); staat ook in de
# Sanity-webhook "GitHub Pages rebuild". Verloopt juli 2027.
GITHUB_WEBHOOK_TOKEN=fine-grained-pat-alleen-repo-desingel-contents-rw

# --- Alleen in CI (deploy.yml), lokaal leeg laten ---
# NUXT_APP_BASE_URL / NUXT_PUBLIC_SITE_URL   - gezet door GitHub Pages
# NUXT_PUBLIC_UMAMI_WEBSITE_ID / NUXT_PUBLIC_UMAMI_SCRIPT_URL
#                                            - repo-variabelen; leeg = statistiek uit
