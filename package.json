{
  "name": "desingel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/generate-sitemap.mjs && node scripts/add-csp.mjs",
    "preview": "npx serve .output/public",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "viewport-check": "node scripts/viewport-check.mjs",
    "typegen": "cd studio && sanity schema extract --enforce-required-fields --path ../types/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.9",
    "@nuxtjs/sanity": "^2.3.0",
    "@portabletext/vue": "^1.0.14",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "nuxt": "^4.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.13.0",
    "playwright": "^1.61.1",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.7"
  }
}
